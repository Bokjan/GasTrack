{
  "name": "gastrack",
  "version": "0.1.0",
  "private": true,
  "description": "GasTrack - 车辆能耗与费用管理系统",
  "scripts": {
    "dev": "pnpm --filter @gastrack/web dev",
    "build": "pnpm --filter @gastrack/web build",
    "preview": "pnpm --filter @gastrack/web preview",
    "lint": "eslint packages/web/src packages/shared/src --report-unused-disable-directives",
    "test": "pnpm -r run test",
    "type-check": "pnpm -r run type-check"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
